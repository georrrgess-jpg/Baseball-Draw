{
  "_comment": "Missions (Update 6). Three daily missions (one per tier) and one weekly mission are drawn from these pools, deterministically per day/week and profile (src/core/missions.gd). 'event' is the progress key: a Profile stat (bumped live during games: total_outs, cards_played, double_plays, boss_*, packs_opened, cards_upgraded ...) or an end-of-game event sent by Rewards.apply (win, win_diff:<difficulty>, cards_<category>, outs_by:<defender>, max_combo, daily_played, caught_stealing, clean_innings, games_played, endless_inning). 'max' events count the best single game instead of adding up. '{n}' is the goal, '{who}' the defender, '{diff}' the difficulty. Rewards are sized against the Update 5 economy (about 3,200 coins and 10 packs per hour of play, tools/balance/economy.py): a full day of missions is worth about 350 coins and a Rookie Pack (about 17 % of an hour's income), the weekly mission a Pro Pack and 20 stars.",
  "daily": [
    {"id": "play_offense", "tier": 1, "event": "cards_offense", "goal": [5, 8], "text": "Play {n} Offense cards"},
    {"id": "play_control", "tier": 1, "event": "cards_control", "goal": [4, 6], "text": "Play {n} Control cards"},
    {"id": "play_defense", "tier": 1, "event": "cards_defense", "goal": [4, 6], "text": "Play {n} Defense cards"},
    {"id": "play_utility", "tier": 1, "event": "cards_utility", "goal": [4, 6], "text": "Play {n} Utility cards"},
    {"id": "outs", "tier": 1, "event": "total_outs", "goal": [120, 180], "step": 10, "text": "Record {n} outs"},
    {"id": "games", "tier": 1, "event": "games_played", "goal": [2, 3], "text": "Finish {n} games"},
    {"id": "open_packs", "tier": 1, "event": "packs_opened", "goal": [3, 5], "text": "Open {n} card packs"},

    {"id": "outs_by", "tier": 2, "event": "outs_by:{who}", "goal": [25, 40], "step": 5, "text": "Make {n} outs with {who}"},
    {"id": "cards_any", "tier": 2, "event": "cards_played", "goal": [20, 30], "step": 5, "text": "Play {n} ability cards"},
    {"id": "double_plays", "tier": 2, "event": "double_plays", "goal": [6, 10], "text": "Turn {n} Double Plays"},
    {"id": "combo", "tier": 2, "event": "max_combo", "max": true, "goal": [3, 4], "text": "Chain a combo of {n} outs"},
    {"id": "clean", "tier": 2, "event": "clean_innings", "goal": [2, 4], "text": "Finish {n} innings without allowing a run"},
