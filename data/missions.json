    {"id": "daily", "tier": 2, "event": "daily_played", "goal": [1, 1], "text": "Finish today's Daily Challenge"},

    {"id": "win", "tier": 3, "event": "win", "goal": [2, 2], "text": "Win {n} games"},
    {"id": "win_diff", "tier": 3, "event": "win_diff:{diff}", "goal": [1, 1], "text": "Win a game on {diff} or harder"},
    {"id": "boss", "tier": 3, "event": "boss_*", "goal": [1, 2], "text": "Defeat {n} bosses"},
    {"id": "steal", "tier": 3, "event": "caught_stealing", "goal": [2, 3], "min_level": 3, "text": "Catch {n} Base Stealers mid-steal (slow, stun or freeze them)"},
    {"id": "standard_innings", "tier": 3, "event": "innings_standard", "goal": [6, 6], "text": "Clear {n} innings of Standard Siege"}
  ],
  "weekly": [
    {"id": "w_wins", "event": "win", "goal": [10, 12], "text": "Win {n} games this week"},
    {"id": "w_outs", "event": "total_outs", "goal": [1500, 2000], "step": 100, "text": "Record {n} outs this week"},
    {"id": "w_cards", "event": "cards_played", "goal": [150, 200], "step": 10, "text": "Play {n} ability cards this week"},
    {"id": "w_daily", "event": "daily_played", "goal": [4, 5], "text": "Finish {n} Daily Challenges this week"},
    {"id": "w_bosses", "event": "boss_*", "goal": [6, 8], "text": "Defeat {n} bosses this week"}
  ],
  "rewards": {
