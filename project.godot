; Engine configuration file.
; Baseball Draw — Godot 4.7 project.

config_version=5

[application]

config/name="Baseball Draw"
config/description="Draw your hand. Defend the diamond. A 3D baseball tower-defense deckbuilder."
config/version="1.0.0"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
config/windows_native_icon="res://assets/textures/logo/icon.ico"
boot_splash/bg_color=Color(0.054902, 0.101961, 0.168627, 1)
boot_splash/show_image=false
config/use_custom_user_dir=true
config/custom_user_dir_name="BaseballDraw"

[autoload]

DB="*res://src/autoload/db.gd"
Settings="*res://src/autoload/settings.gd"
InputConfig="*res://src/autoload/input_config.gd"
Profile="*res://src/autoload/profile.gd"
Audio="*res://src/autoload/audio_manager.gd"
Session="*res://src/autoload/session.gd"
Router="*res://src/autoload/router.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.054902, 0.101961, 0.168627, 1)

[debug]

gdscript/warnings/inference_on_variant=1
gdscript/warnings/unused_parameter=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/return_value_discarded=0
gdscript/warnings/unused_signal=0
